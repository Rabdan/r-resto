FROM node:22-bookworm-slim

RUN apt-get update \
	&& apt-get install -y --no-install-recommends python3 make g++ \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173

CMD ["sh", "-c", "if [ ! -d node_modules/better-sqlite3 ]; then npm ci; fi; npm run dev -- --host 0.0.0.0 --port 5173"]
